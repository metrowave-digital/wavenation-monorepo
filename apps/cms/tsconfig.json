{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    /* ===== 🌊 TypeScript Core ===== */
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    /* ===== 🧩 Plugins ===== */
    "plugins": [
      {
        "name": "payload"
      },
      {
        "name": "next"
      }
    ],
    /* ===== 🧠 Monorepo Path Aliases ===== */
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@payload-config": ["./src/payload.config.ts"],
      "@config/*": ["../../packages/config/src/*"],
      "@auth-service/*": ["../../services/auth/src/*"]
    }
  },
  /* ===== 📦 File Includes ===== */
  "include": ["payload.config.ts", "src", "src/**/*.ts", "src/**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules", "build", "dist"]
}
