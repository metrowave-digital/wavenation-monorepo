{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    /* ===== 🌊 Next.js Defaults ===== */
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,

    /* ===== 🧩 Monorepo Path Aliases ===== */
    "baseUrl": ".",
    "paths": {
      "@web/*": ["./src/*"],
      "@ui/*": ["../../packages/ui/src/*"],
      "@api-client/*": ["../../packages/api-client/src/*"],
      "@config/*": ["../../packages/config/src/*"],
      "@auth-service/*": ["../../services/auth/src/*"]
    },

    /* ===== 🧠 Next.js Plugin ===== */
    "plugins": [
      {
        "name": "next"
      }
    ]
  },

  /* ===== 📦 Included Files ===== */
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}
