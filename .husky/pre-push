#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

echo "🚀 Running build verification before push..."

# Step 1: Auto-format code (Prettier)
echo "🧹 Auto-fixing Prettier formatting..."
pnpm exec prettier --write .

# Step 2: Run lint with auto-fix support (Turbo → ESLint)
echo "🔍 Running ESLint across packages..."
pnpm exec turbo run lint -- --fix || {
  echo "❌ ESLint found issues that couldn’t be fixed automatically."
  echo "💡 Run 'pnpm exec turbo run lint -- --fix' locally to see details."
  exit 1
}

# Step 3: Optional type checking (only if tsconfig exists)
if [ -f "tsconfig.json" ]; then
  echo "🧠 Running TypeScript type check..."
  pnpm exec turbo run typecheck || {
    echo "❌ Type errors detected — please fix before pushing."
    exit 1
  }
fi

echo "✅ All checks passed. Pushing to remote..."
