#!/usr/bin/env sh
. "$(dirname "$0")/_/husky.sh"

echo "🚀 Running build verification before push..."
echo "🧹 Auto-fixing Prettier formatting..."
pnpm prettier --write .

echo "🔍 Running ESLint across packages..."
pnpm turbo run lint --filter=...

if [ $? -ne 0 ]; then
  echo "❌ Lint errors detected — fix before pushing."
  exit 1
fi
